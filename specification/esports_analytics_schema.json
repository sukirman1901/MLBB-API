{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLBB Dataset API Schema Specification",
  "description": "JSON Schema specification for MLBB Heroes, Equipment, Emblems, Counters, Synergies, and Draft Pick Analysis",
  "type": "object",
  "properties": {
    "hero_dataset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hero_name": { "type": "string" },
          "id": { "type": "string" },
          "class": { "type": "string" },
          "laning": { "type": "array", "items": { "type": "string" } },
          "tier": { "type": "string", "enum": ["SS", "S", "A", "B", "C", "D"] },
          "tier_score": { "type": "number" },
          "ban_rate": { "type": "string" },
          "contested_rate": { "type": "string" },
          "base_stats": {
            "type": "object",
            "properties": {
              "HP": { "type": "integer" },
              "Mana": { "type": "integer" },
              "Physical Attack": { "type": "integer" },
              "Physical Defense": { "type": "integer" },
              "Magic Defense": { "type": "integer" },
              "Movement Speed": { "type": "integer" }
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_name": { "type": "string" },
                "type": { "type": "string", "enum": ["passive", "active"] },
                "cooldown": { "type": "string" },
                "manacost": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "counters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heroname": { "type": "string" },
                "relation": { "type": "string", "enum": ["strong_against", "weak_against"] }
              }
            }
          },
          "synergies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heroname": { "type": "string" }
              }
            }
          },
          "recommended_builds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "build_name": { "type": "string" },
                "items": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "equipment_dataset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": { "type": "string" },
          "category": { "type": "string", "enum": ["Attack", "Magic", "Defense", "Movement"] },
          "price": { "type": "integer" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "modifiers": { "type": "object" },
                "unique_passive": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "emblem_dataset": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emblem_name": { "type": "string" },
          "talents": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

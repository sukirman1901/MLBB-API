{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLBB Esports Match & Analytics Schema Specification",
  "description": "JSON Schema specification for Tournaments, Teams, Players, Match Records, Draft Picks/Bans, and Player Performances",
  "type": "object",
  "properties": {
    "tournament": {
      "type": "object",
      "properties": {
        "tournament_id": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "year": { "type": "integer" },
        "game_version": { "type": "string" },
        "participating_teams": { "type": "array", "items": { "type": "string" } }
      }
    },
    "team": {
      "type": "object",
      "properties": {
        "team_id": { "type": "string" },
        "name": { "type": "string" },
        "short_name": { "type": "string" },
        "region": { "type": "string" },
        "roster": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "player_name": { "type": "string" },
              "role": { "type": "string", "enum": ["EXP", "Jungle", "Mid", "Gold", "Roam"] }
            }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "properties": {
        "player_id": { "type": "string" },
        "ign": { "type": "string" },
        "team": { "type": "string" },
        "role": { "type": "string", "enum": ["EXP", "Jungle", "Mid", "Gold", "Roam"] },
        "comfort_heroes": { "type": "array", "items": { "type": "string" } },
        "signature_pick": { "type": "string" }
      }
    },
    "match": {
      "type": "object",
      "properties": {
        "match_id": { "type": "string" },
        "tournament": { "type": "string" },
        "season": { "type": "integer" },
        "patch": { "type": "string" },
        "duration_seconds": { "type": "integer" },
        "winner": { "type": "string" },
        "blue_team": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "bans": { "type": "array", "items": { "type": "string" } },
            "picks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": { "type": "integer" },
                  "hero": { "type": "string" },
                  "player": { "type": "string" },
                  "role": { "type": "string" }
                }
              }
            }
          }
        },
        "red_team": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "bans": { "type": "array", "items": { "type": "string" } },
            "picks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": { "type": "integer" },
                  "hero": { "type": "string" },
                  "player": { "type": "string" },
                  "role": { "type": "string" }
                }
              }
            }
          }
        },
        "player_performances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "player": { "type": "string" },
              "team": { "type": "string" },
              "hero": { "type": "string" },
              "role": { "type": "string" },
              "kda": {
                "type": "object",
                "properties": {
                  "kills": { "type": "integer" },
                  "deaths": { "type": "integer" },
                  "assists": { "type": "integer" }
                }
              },
              "gold": { "type": "integer" },
              "gpm": { "type": "number" },
              "damage_dealt": { "type": "integer" },
              "damage_taken": { "type": "integer" },
              "items": { "type": "array", "items": { "type": "string" } },
              "emblem": {
                "type": "object",
                "properties": {
                  "main": { "type": "string" },
                  "talents": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
